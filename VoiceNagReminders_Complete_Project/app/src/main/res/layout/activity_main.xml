<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#0F172A">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Voice Nag Reminders"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnMic"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="🎙️ Tap &amp; Speak Task"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#3B82F6"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap mic and speak your reminder"
        android:textColor="#94A3B8"
        android:padding="8dp"
        android:textAlignment="center" />

    <EditText
        android:id="@+id/etTaskTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Task recognized or manual title"
        android:textColor="#FFFFFF"
        android:textColorHint="#64748B"
        android:background="#1E293B"
        android:padding="12dp"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btnSave"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Save &amp; Start Nagging Reminder"
        android:backgroundTint="#10B981"
        android:textColor="#FFFFFF"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Active Reminders"
        android:textColor="#F8FAFC"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>